    ports:
      - "8000:8000"
    env_file:
      - ./Backend/.env
    environment:
      - DATABASE_URL=postgresql://postgres:9qRYM_6$$&izta&!@db.jdfpfuursllupsrvmnko.supabase.co:5432/postgres
